# Install header contents, not links into Bazel's temporary build-script runfiles.
# CMake preserves source symlinks when installing PUBLIC_HEADER files.
--- a/opus/CMakeLists.txt
+++ b/opus/CMakeLists.txt
@@ -287,3 +287,15 @@
+# Install regular files, not symlinks into temporary build-script runfiles.
+# CMake's REALPATH does not resolve Windows file symlinks. COPYONLY reads the
+# contents instead and preserves them without newline or variable conversion.
+set(Opus_INSTALL_HEADER "")
+foreach(header IN LISTS Opus_PUBLIC_HEADER)
+  get_filename_component(header_name "${header}" NAME)
+  set(install_header "${CMAKE_CURRENT_BINARY_DIR}/install-headers/${header_name}")
+  configure_file("${header}" "${install_header}" COPYONLY)
+  list(APPEND Opus_INSTALL_HEADER "${install_header}")
+endforeach()
+set(Opus_PUBLIC_HEADER "${Opus_INSTALL_HEADER}")
+
 if(MSVC)
   if(OPUS_STATIC_RUNTIME)
     if(CMAKE_BUILD_TYPE MATCHES DEBUG)
