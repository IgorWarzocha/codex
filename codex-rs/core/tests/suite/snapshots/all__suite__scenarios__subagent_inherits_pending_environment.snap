          <status>starting</status>
        </environment>
      </environments>
      <current_date><CURRENT_DATE></current_date>
      <timezone><HOST_TIMEZONE></timezone>
    </environment_context>
04:message/user:
    Delegate waiting for the shared workspace, and report what the worker finds.
